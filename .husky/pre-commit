# 提交门禁（pre-commit）：三阶段
#
# ① ESLint  ② Prettier —— 只针对**暂存文件**（lint-staged），快且自动修复
# ③ 单测 —— 组件库 jest + 共享配置包自检
#
# 任一步失败 → 提交被拒绝。想跳过只能在明确知道后果时用 `git commit --no-verify`。

set -e

echo "▶ [1/3] ESLint + [2/3] Prettier（暂存文件）"
pnpm lint-staged

echo "▶ [3/3] 单测"
pnpm --filter @qyani/eslint-config run test
# 直接调 jest（用 `run test -- --ci` 在 sh 里会把 `--` 也当成参数传给 jest）
pnpm --filter @cross-terminal/components exec jest --ci

echo "✔ 门禁通过"
