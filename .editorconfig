# 统一编辑器行为（VS Code / JetBrains / Vim 都认这个文件）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{kt,kts,java}]
indent_size = 4

[*.md]
# Markdown 里行尾两个空格是换行，不能删
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
