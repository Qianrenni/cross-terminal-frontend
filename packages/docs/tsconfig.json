{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    // 本包不预编译组件库，tsc 会顺着 `@cross-terminal/components` 进到组件源码；
    // 那里用了 `@/` 别名（组件库内部 = packages/components/src），所以这边也要认。
    // ⚠️ 因此**本包自身不要用 `@/`**，它指向的是组件库源码，不是 docs 的 src。
    // 不用 baseUrl（TS 7.0 起移除）；paths 相对本文件解析。
    "paths": {
      "@/*": ["../components/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
