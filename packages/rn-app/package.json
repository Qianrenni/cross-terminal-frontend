{
  "name": "@cross-terminal/rn-app",
  "version": "1.0.0",
  "private": true,
  "description": "跨端容器 RN 业务工程：产出可供 OTA 下发的 Hermes Bundle",
  "scripts": {
    "start:rn": "react-native start",
    "start:web": "vite",
    "build:web": "vite build",
    "build:bundle": "node ../../scripts/build-bundle.mjs",
    "publish:bundle": "node ../../scripts/publish-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit"
  },
  "dependencies": {
    "@cross-terminal/components": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.87.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
