# 统一换行符与文本文件判定（初始化 git 后生效）
# 仓库统一用 LF；Windows 工作区由 Prettier（endOfLine: lf）+ .editorconfig 配合
* text=auto eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ttf binary
*.jar binary
*.keystore binary

# Windows 批处理必须是 CRLF，否则 cmd 解析可能出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 锁文件不要合并（冲突时重新生成）
pnpm-lock.yaml merge=ours
